# Built binaries: camlab.exe is published as a release download, not committed
*.exe

# build intermediates (src/Makefile, src/build.bat)
*.o
*.ico
*.rc

# CamLab's screenshots (F12) and --shots frames
camlab_*.png
shot_*.png

# release packaging
dist/
*.zip

# tools/ outputs
__pycache__/
tools/*.json
tools/*.csv
tools/shots/

# this PC's paths (written by PLAY.bat / the setup window)
setup.yaml

# your own announcer recordings (and the placeholders SR3 Extras starts with)
announcer/

# another co-driver's clips (taken from your own copy of another game: SEGA Rally 2's in codriver/, the 1995
# SEGA Rally Championship's in codriver/src/, made by tools/audio/src_audio.py)
codriver/

# another game's music (music/src/: the 1995 tunes recorded from your own ROM set by tools/audio/src_music.py)
music/

# race sounds converted from your own PlayStation 3 disc
sounds/

# what PLAY.bat's window said on the last run
play.log

# the watchdog's crash and freeze records and minidumps (they hold the game's memory)
crash/

# local Blender scenes of imported courses (they hold SEGA geometry and textures: never committed)
blender/
*.blend
*.blend1

# compiled helpers of the importer (built from the .c files beside them on first use)
*.dll
*.pyc

# the import stack's data (tools/import/settings.json says where: builds, ROM extracts, SEGA textures - never committed),
# its default places inside the repository, your ROM sets, and this PC's settings
/data/
/roms/
/tools/import/settings.json
/classic/

# handling flavors (docs/kb/28_handling_flavors.md): the owner's own choice of flavors, and any flavor build staged in the
# repository (built car / grip files are SEGA data: they go to the game folder, never here)
/handling.json
/tools/handling/stage_*/
/tools/handling/*.sbf
/tools/handling/flavor_realism.json
