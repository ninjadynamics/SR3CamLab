# Built binaries: camlab.exe is published as a release download, not committed
*.exe

# build intermediates (src/Makefile, src/build.bat)
*.o
*.ico
*.rc

# CamLab's screenshots (F12) and --shots frames
camlab_*.png
shot_*.png

# release packaging
dist/
*.zip

# tools/ outputs
__pycache__/
tools/*.json
tools/*.csv
tools/shots/

# this PC's paths (written by PLAY.bat / the setup window)
setup.yaml

# your own announcer recordings (and the placeholders SR3 Extras starts with)
announcer/

# another co-driver's clips (taken from your own copy of another game)
codriver/

# race sounds converted from your own PlayStation 3 disc
sounds/

# what PLAY.bat's window said on the last run
play.log

# local Blender scenes of imported courses (they hold SEGA geometry and textures: never committed)
blender/
*.blend
*.blend1

# compiled helpers of the importer (built from the .c files beside them on first use)
*.dll
*.pyc

# the importer's data folders (links to the work folder outside the repository: builds, ROM extracts, SEGA textures - never committed)
/scripts/tmp/
/scripts/out/
/scripts/classic_tex/
/scripts/previews/
/scripts/retex/
/classic/
# link to /courses (the importer looks for it beside itself)
/scripts/courses/
